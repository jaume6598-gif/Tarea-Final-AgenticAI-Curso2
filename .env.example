
# Configuracion de Gemini
GOOGLE_API_KEY=COLOCAR_API_KEY_AQUI
MODELO=gemini-2.5-flash
# Modelo de respaldo si el principal falla o agota el tiempo
MODELO_RESPALDO=gemini-2.5-flash-lite
TIMEOUT_LLM_S=30

# Limites del ciclo ReAct (condiciones de parada explicitas)
MAX_PASOS_REACT=25
MAX_LLAMADAS_HERRAMIENTA=4

# Seguridad de FastAPI (cabecera X-API-Key)
# Token lector: acceso normal a /consultar y /registros
APP_API_TOKEN=COLOCAR_TOKEN_AQUI
# Token administrador: ademas permite acciones protegidas (eliminar_lote)
APP_ADMIN_TOKEN=COLOCAR_TOKEN_ADMIN_AQUI

# A2A Jaime -> Gerardo (Bearer exigido por message/send de Gerardo)
A2A_TOKEN=COLOCAR_TOKEN_A2A_AQUI
URL_GERARDO=http://127.0.0.1:8001
TIMEOUT_A2A_S=90

# Demostracion de resiliencia: habilita la cabecera X-Simular-Fallo
# (valores: modelo | a2a | timeout)
PERMITIR_SIMULACION_FALLOS=true

# Datos de ejemplo: fecha "hoy" del inventario (vencimientos reproducibles)
FECHA_REFERENCIA=2026-12-01

# Ampliaciones (opcionales)
DATABASE_URL=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
N8N_A2A_URL=
N8N_TOKEN=
MCP_URL=
MCP_TOKEN=
